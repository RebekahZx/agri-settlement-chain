# Copy to .env and fill in. Never commit .env.
# Only needed for the Sepolia experiments (exp1, exp2, deploy).
SEPOLIA_URL=
PRIVATE_KEY=

# Optional: pin the ETH/USD price used by scripts/combine_results.js
# (the stored cost_analysis.json used 2058.06).
ETH_PRICE_USD=
# Optional: INR per USD used for cost conversion (default 83.5).
INR_PER_USD=
